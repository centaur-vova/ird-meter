#!/usr/bin/env php
<?php

declare(strict_types=1);

$autoloadPaths = [
    __DIR__ . '/../vendor/autoload.php',
    __DIR__ . '/../../../autoload.php',
];

$autoloadFound = false;
foreach ($autoloadPaths as $path) {
    if (file_exists($path)) {
        require $path;
        $autoloadFound = true;
        break;
    }
}

if (!$autoloadFound) {
    fwrite(STDERR, "Could not find Composer autoload.php\n");
    fwrite(STDERR, "Run 'composer install' first.\n");
    exit(1);
}

use CentaurVova\IrdMeter\IrdCalculator;

// ANSI colors (only for TTY)
$isTty = stream_isatty(STDOUT);
$isErrTty = stream_isatty(STDERR);
$green = $isTty ? "\033[32m" : '';
$yellow = $isTty ? "\033[33m" : '';
$red = $isTty ? "\033[31m" : '';
$cyan = $isTty ? "\033[36m" : '';
$reset = $isTty ? "\033[0m" : '';
$errRed = $isErrTty ? "\033[31m" : '';
$errReset = $isErrTty ? "\033[0m" : '';

$args = $argv;
array_shift($args);

$dir = '.';
$raw = false;
$json = false;
$threshold = null;
$ignoreComments = false;
$includeElseif = false;
$includeTernary = false;
$includeMatch = false;
$exclude = ['vendor', '.git', 'node_modules', 'var/cache'];

foreach ($args as $arg) {
    if ($arg === '--help' || $arg === '-h') {
        echo <<<HELP
IRD — If/Row Density calculator

Usage:
  ird-meter [directory] [options]

Arguments:
  directory          Directory to scan (default: current directory)

Options:
  --raw              Output only the IRD number
  --json             Output JSON
  --threshold=N      Exit 1 if IRD > N (for CI)
  --exclude=A,B      Comma-separated directories to exclude
                     (default: vendor,.git,node_modules,var/cache)
  --ignore-comments  Count only non-comment, non-empty lines
  --include-elseif   Count elseif branches too
  --include-ternary  Count ternary operators
  --include-match    Count match expressions
  --all              Enable all optional counters
  --help, -h         Show this help

Examples:
  ird-meter app
  ird-meter app --raw
  ird-meter app --threshold=5
  ird-meter src --all --json
  ird-meter app --exclude=vendor,tests

HELP;
        exit(0);
    }

    if ($arg === '--raw') {
        $raw = true;
    } elseif ($arg === '--json') {
        $json = true;
    } elseif ($arg === '--ignore-comments') {
        $ignoreComments = true;
    } elseif ($arg === '--include-elseif') {
        $includeElseif = true;
    } elseif ($arg === '--include-ternary') {
        $includeTernary = true;
    } elseif ($arg === '--include-match') {
        $includeMatch = true;
    } elseif ($arg === '--all') {
        $includeElseif = true;
        $includeTernary = true;
        $includeMatch = true;
    } elseif (str_starts_with($arg, '--threshold=')) {
        $threshold = (float) substr($arg, strlen('--threshold='));
    } elseif (str_starts_with($arg, '--exclude=')) {
        $exclude = array_filter(explode(',', substr($arg, strlen('--exclude='))));
    } elseif (!str_starts_with($arg, '--')) {
        $dir = $arg;
    }
}

$realDir = realpath($dir);
if ($realDir === false || !is_dir($realDir)) {
    fwrite(STDERR, "{$errRed}Directory not found: {$dir}{$errReset}\n");
    fwrite(STDERR, "Run 'ird-meter --help' for usage.\n");
    exit(1);
}

$calculator = new IrdCalculator(
    includeElseif: $includeElseif,
    includeTernary: $includeTernary,
    includeMatch: $includeMatch,
    ignoreComments: $ignoreComments,
    exclude: $exclude,
);

// Spinner (only for human-readable output)
$spinner = ['⠋', '⠙', '⠹', '⠸', '⠼', '⠴', '⠦', '⠧', '⠇', '⠏'];
$spinnerIndex = 0;
$useSpinner = !$raw && !$json && $isTty;

if ($useSpinner) {
    fwrite(STDOUT, "{$cyan}" . $spinner[0] . " Scanning...{$reset}");
}

$result = $calculator->calculate($realDir, function () use (&$spinnerIndex, $spinner, $useSpinner, $cyan, $reset) {
    if ($useSpinner) {
        fwrite(STDOUT, "\r{$cyan}" . $spinner[$spinnerIndex++ % count($spinner)] . " Scanning...{$reset}");
    }
});

if ($useSpinner) {
    fwrite(STDOUT, "\r{$green}Done.     {$reset}\n");
}

if ($raw) {
    echo $result->density . "\n";
    exit(0);
}

if ($json) {
    echo json_encode($result->toArray(), JSON_PRETTY_PRINT) . "\n";
    exit(0);
}

echo "PHP IRD (If/Row Density)\n";
echo "  If count:    {$result->ifWeight}\n";
echo "  Total lines: {$result->totalLines}\n";
echo "  Files:       {$result->files}\n";
echo sprintf("  IRD:         %.2f%%\n", $result->density);
echo "\n";

if ($result->isClean()) {
    echo "  {$green}clean{$reset} — this code is linear like a horse's path\n";
} elseif ($result->isGood()) {
    echo "  {$yellow}good{$reset} — some branches, but manageable\n";
} elseif ($result->needsAttention()) {
    echo "  {$yellow}needs attention{$reset} — too many ifs\n";
} else {
    echo "  {$red}for ponies{$reset} — this code is a maze\n";
}

if ($threshold !== null && $result->density > $threshold) {
    echo "\n{$red}IRD {$result->density}% exceeds threshold {$threshold}%{$reset}\n";
    exit(1);
}

exit(0);
