{
    "name": "centaur-vova/ird-meter",
    "description": "If/Row Density (IRD) calculator for PHP projects — how linear is your code?",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "ird",
        "static-analysis",
        "code-quality",
        "complexity",
        "if-density",
        "php-parser"
    ],
    "authors": [
        {
            "name": "Dmitry Shmanatov",
            "email": "dshmanatov@icloud.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "nikic/php-parser": "^5.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "bin": [
        "bin/ird-meter"
    ],
    "autoload": {
        "psr-4": {
            "CentaurVova\\IrdMeter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CentaurVova\\IrdMeter\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}